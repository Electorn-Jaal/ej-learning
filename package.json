{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "corepack pnpm --parallel --filter @workspace/api-server --filter @workspace/ej-learning run dev",
    "db:check": "corepack pnpm --filter @workspace/db run check",
    "test": "corepack pnpm --filter @workspace/ej-learning --filter @workspace/api-server run test",
    "build": "corepack pnpm run typecheck && corepack pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "corepack pnpm run typecheck:libs && corepack pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:setup": "node --env-file-if-exists=.env lib/db/scripts/setup-local.mjs",
    "db:demo": "corepack pnpm --filter @workspace/api-server run seed-demo-school --yes",
    "db:demo:walk": "corepack pnpm --filter @workspace/api-server run walk-demo"
  },
  "private": true,
  "dependencies": {
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
