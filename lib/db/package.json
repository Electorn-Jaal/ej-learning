{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "check": "node --env-file-if-exists=../../.env scripts/check.mjs",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "introspect": "drizzle-kit introspect --config ./drizzle.config.ts",
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.mjs",
    "check-drift": "drizzle-kit check --config ./drizzle.config.ts",
    "mark-baseline": "node --env-file-if-exists=../../.env scripts/mark-baseline.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
