# Copy to deploy/.env; never commit the filled file.
EJ_IMAGE_PREFIX=ej-learning
# Use the reviewed source commit/release identifier, never latest.
EJ_VERSION=replace-with-release-id
POSTGRES_IMAGE=postgres:18-bookworm
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_URL=postgresql://ej_owner:replace-with-random-hex-password@db:5432/ej_learning
EJ_STORAGE_PATH=/srv/ej-learning/storage
EJ_HTTP_PORT=18080
