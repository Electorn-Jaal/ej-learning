# Copy only if .env does not already exist. Never commit real credentials.
# URL-encode special characters in the database username/password.
#
# New machine: create an EMPTY database named ej_learning_local (or
# ej_learning_test, optionally with a _suffix), point DATABASE_URL at it and run
# `corepack pnpm db:setup`. See the README's "Database бэлтгэх" section.
# ej_learning_dev is the existing development database; db:setup refuses it.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ej_learning_local
API_PORT=5000
WEB_PORT=5173
BASE_PATH=/
# Optional when the API runs on a different host:
# API_PROXY_TARGET=http://127.0.0.1:5000

# Absolute path to this checkout's storage directory. Replace before use.
# Windows example: C:/work/ej-learning/storage
EJ_STORAGE_DIR="/absolute/path/to/repo/storage"

# Login uses application accounts and session cookies; no preview flag is needed.
# Google OAuth is not wired up; credentials alone will not enable integration.
