# Copy to .env and supply your existing PostgreSQL credentials.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ej_learning_dev
API_PORT=5000
WEB_PORT=5173
BASE_PATH=/
# Enables local read-only access to real data. Disabled in NODE_ENV=production.
# Optional fixed student selection; otherwise use the dropdown in the app.
# Optional when the API runs on a different host:
# API_PROXY_TARGET=http://127.0.0.1:5000

# Planned Google integration: not consumed by the current mock implementation.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback

# Where uploaded content files live.
EJ_STORAGE_DIR="/absolute/path/to/repo/storage"
